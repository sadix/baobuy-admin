// APPLY IN THE MAIN APP (sadix/commerce_saas) — it owns the schema and runs all migrations.
// Additive: merge the User fields + relation into your existing `User` model, add the two new models,
// then `npx prisma migrate dev --name admin_support`. Afterwards re-sync schema.prisma into the admin project.

model User {
  // ...your existing fields...
  isSuspended Boolean      @default(false)
  lastLoginAt DateTime?
  loginEvents LoginEvent[]
}

// Written by the main app on every successful owner sign-in; read by the admin app.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Written by the admin app only. No relations on purpose, so audit rows survive any deletion.
model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String   // UPDATE | DELETE
  resource   String   // users | shops | products ...
  targetId   String?
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([resource, targetId])
}
